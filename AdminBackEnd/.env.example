NODE_ENV=development
PORT=5001

# PostgreSQL connection string. Leave empty in development to share the
# JSON files in ../BackEnd/data with the public API.
DATABASE_URL=

# Origins allowed to call this API (the admin panel), comma-separated
CLIENT_URL=http://localhost:5174

# Optional. A signing secret is generated and stored in data/jwt-secret when unset.
JWT_SECRET=

# Optional. Where uploaded images are written and the public URL they are served from.
# Defaults: ./uploads, served by this API under /admin-api/v1/uploads
UPLOAD_DIR=
UPLOAD_PUBLIC_URL=

# Copy to .env on the server and fill in real values.
NODE_ENV=production
PORT=5000

# PostgreSQL connection string (preferred). On cPanel: create the database and
# user under PostgreSQL Databases, then use 127.0.0.1 as the host.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME

# Alternative: MongoDB. Only used when DATABASE_URL is empty.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nyulo_interior

# Every origin allowed to call the API, comma-separated
CLIENT_URL=https://nyulo.com,https://www.nyulo.com

# Long random string — protects admin write endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
